load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

cmake(
    name = "naja",
    # All naja sources including nested submodules
    lib_source = ":all_srcs",
    # Output shared libraries that kepler-formal links against
    out_shared_libs = [
        "libnaja_nl.so",
        "libnaja_dnl.so",
        "libnaja_bne.so",
        "libnaja_opt.so",
        "libnaja_snl_pyloader.so",
    ],
    # Output static libraries
    out_static_libs = [
        "libnaja_core.a",
        "libnaja_snl_visual.a",
        "libnaja_snl_verilog.a",
        "libnaja_snl_liberty.a",
        "libnaja_verilog.a",
        "libyosys_liberty.a",
    ],
    cache_entries = {
        "CMAKE_CXX_STANDARD": "20",
        "BUILD_NAJA_PYTHON": "OFF",
        "BUILD_ONLY_DOC": "OFF",
        "BUILD_BENCHMARKS": "OFF",
        "CODE_COVERAGE": "OFF",
        "ENABLE_SANITIZERS": "OFF",
    },
    # Let cmake find system-installed Boost, TBB, CapnProto, Python3
    # This is the pragmatic approach (same as OpenROAD's initial Bazel adoption)
    # Tighten hermeticity later by providing these through Bazel
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)
