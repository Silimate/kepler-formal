load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel:naja_includes.bzl", "NAJA_HEADER_COPTS")

cc_binary(
    name = "kepler-formal",
    srcs = [
        "KeplerFormal.cpp",
        "KeplerFormalUtils.h",
    ],
    copts = NAJA_HEADER_COPTS,
    # capnp/kj (static), TBB (shared, bundled in the release tarball) and
    # zlib arrive transitively through @naja's cmake deps — no system -l
    # flags. libstdc++/libgcc stay static for portable release binaries.
    linkopts = select({
        "@platforms//os:macos": [],
        "//conditions:default": [
            "-static-libstdc++",
            "-static-libgcc",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//src/config:kepler_config",
        "//src/sec:kepler_sec",
        "//src/scope:scope_extraction",
        "//src/strategies:formal_strategies",
        "@kissat",
        "@naja",
        "@naja//:naja_extra_headers",
        "@spdlog",
        "@yaml-cpp",
    ],
)
